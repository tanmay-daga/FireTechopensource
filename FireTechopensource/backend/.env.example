# Copy this file to ".env" and edit. Never commit your real .env (it is git-ignored).
# This backend needs NO API keys: everything runs locally through Ollama.

# --- Ollama (local AI) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Context window in tokens. Lower to 8192 if your computer is slow or low on memory.
OLLAMA_NUM_CTX=16384
# Max seconds for ONE model call, and for the whole analysis request.
OLLAMA_TIMEOUT_S=180
REQUEST_TIMEOUT_S=540

# --- Upload and repository limits ---
MAX_UPLOAD_MB=10
MAX_FILES=100
MAX_FILE_SIZE_KB=200
# Most source the scanner will read from a repository.
MAX_TOTAL_SOURCE_KB=500
# Most source actually sent to Gemma in one request (a small model needs far less than 500 KB).
MAX_PROMPT_SOURCE_KB=40
MAX_SELECTED_FILES=8

# --- Security ---
# Exact browser origins allowed to call this API (comma-separated, no "*").
# Add the address your frontend is served from (VS Code Live Server uses :5500).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional: only allow scanning inside these folders (comma-separated). Empty = any folder.
ALLOWED_REPO_ROOTS=

LOG_LEVEL=INFO
